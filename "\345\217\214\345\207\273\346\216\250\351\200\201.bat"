@echo off
chcp 65001 >nul 2>&1
cd /d "%~dp0"

set LOG=%~dp0_push.log
echo ============================================ >  "%LOG%"
echo   云南公考编招平台 - 推送日志                    >> "%LOG%"
echo   %date% %time%                                 >> "%LOG%"
echo   仓库: https://github.com/ZZhenganqi/yunnan-jobs >> "%LOG%"
echo ============================================ >> "%LOG%"
echo. >> "%LOG%"

echo.
echo  正在推送到 GitHub...
echo  详细日志同时写入 _push.log
echo  如果弹出 GitHub 授权窗口（浏览器或通知中心），请点 Authorize
echo  请保持本窗口在前台，不要关闭
echo.

git push -u origin main 1>>"%LOG%" 2>&1
set RC=%errorlevel%

echo. >> "%LOG%"
echo ----- 执行结果 ----- >> "%LOG%"
echo git 退出码: %RC% >> "%LOG%"

if %RC% neq 0 (
  echo.
  echo  推送失败 (git 退出码 %RC%)
  echo  请打开本目录的 _push.log 查看详细原因
  echo  然后把日志内容截图或复制给我
  echo.
  echo  最常见原因:
  echo    1. 错过了 GitHub 授权弹窗（去通知中心找，或重新双击本脚本）
  echo    2. 凭据管理器没保存 token（重试时应该会自动重弹窗）
  echo.
  echo  按任意键关闭...
  pause >nul
  exit /b 1
)

echo  推送成功！正在打开 GitHub 页面...
echo.

start https://github.com/ZZhenganqi/yunnan-jobs/actions
start https://github.com/ZZhenganqi/yunnan-jobs/settings/pages
echo  已打开 Actions 页面和 Pages 设置页面。
echo  1. 在 Pages 页把 Source 选成 "GitHub Actions"
echo  2. 进 Actions 页手动点 Run workflow 跑一次
echo  3. 跑完就有公网网址
echo.
pause
