@echo off
chcp 65001 >nul 2>&1
cd /d "%~dp0"

echo.
echo ============================================
echo    云南公考编招平台 - 一键更新并发布
echo ============================================
echo.
echo  第 1 步: 本地抓取 20 个官方数据源（约 1-3 分钟）
echo.

node scripts/fetch.mjs
if errorlevel 1 (
  echo.
  echo  抓取失败，已停止发布。
  pause
  exit /b 1
)

echo.
echo  第 2 步: 发布到 GitHub（Pages 会自动更新）
echo.

node scripts/publish.mjs
if errorlevel 1 (
  echo.
  echo  发布失败。若提示 token 失效，请重新生成 PAT 后运行:
  echo    node scripts/publish.mjs --token=你的新token
  echo.
  pause
  exit /b 1
)

echo.
echo  完成。网站约 1-2 分钟后更新。
echo.
start https://zzhenganqi.github.io/yunnan-jobs/
pause
